clear;
clc;
close all;

%% ========================================================================
% 第一步：只读取全部830完整原始文件
% 每个文件分别提取：
%
%   IMU
%   GPCHCX
%   GPGGA
%
% 暂时不做任何其他处理
% ========================================================================

raw_dir = ...
    'D:\Github\KF-GINS-Matlab\data\experiment-data\experiment-02\1207-longtime\raw';

temp_dir = ...
    'D:\Github\KF-GINS-Matlab\data\experiment-data\experiment-02\1207-longtime\temp';

FILE_830 = {
    '043941_4752450.dat'
    '083942_4752450.dat'
    '110223_4752450.dat'
    '150224_4752450.dat'
};

Raw830 = struct([]);

for i = 1:numel(FILE_830)

    filename = ...
        fullfile(raw_dir,FILE_830{i});

    fprintf('\n');
    fprintf('============================================================\n');
    fprintf('读取830文件 %d/%d\n',i,numel(FILE_830));
    fprintf('%s\n',FILE_830{i});
    fprintf('============================================================\n');

    if ~exist(filename,'file')
        error('文件不存在：%s',filename);
    end

    tic;

    % ================================================================
    % 这里需要使用你“完整830 DAT”的三个解析函数
    % ================================================================

    [Raw830(i).imu, Raw830(i).gpgga, Raw830(i).gpgga] = read_mems_ins(filename, filename, filename);
    % IMU_tmp    = ...
    %     从 filename 提取 IMU;

    GPCHCX_tmp = ...
        read_gpchcx_430_830(filename);

    % GPGGA_tmp  = ...
    %     从 filename 提取 GPGGA;

    % ================================================================

    Raw830(i).name = ...
        FILE_830{i};

    % Raw830(i).imu = ...
    %     IMU_tmp;

    Raw830(i).gpchcx = ...
        GPCHCX_tmp;

    % Raw830(i).gpgga = ...
    %     GPGGA_tmp;

    Raw830(i).read_time = ...
        toc;


    %% ---------------------------------------------------------------
    % 这里只打印读取数量
    % 不筛选、不修改
    % ---------------------------------------------------------------

    fprintf('读取耗时：%.2f s\n', ...
        Raw830(i).read_time);

    % fprintf('IMU：   %d × %d\n', ...
    %     size(IMU_tmp,1), ...
    %     size(IMU_tmp,2));

    fprintf('GPCHCX：%d × %d\n', ...
        size(GPCHCX_tmp,1), ...
        size(GPCHCX_tmp,2));

    % fprintf('GPGGA： %d × %d\n', ...
    %     size(GPGGA_tmp,1), ...
    %     size(GPGGA_tmp,2));

end


%% ========================================================================
% 保存完整原始解析结果
% ========================================================================

save_file = ...
    fullfile(temp_dir,'raw830_all.mat');

save( ...
    save_file, ...
    'Raw830', ...
    '-v7.3');

fprintf('\n');
fprintf('============================================================\n');
fprintf('830全部原始文件读取完成\n');
fprintf('%s\n',save_file);
fprintf('============================================================\n');