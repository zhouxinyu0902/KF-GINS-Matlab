clear
truth=importdata('dataset1/truth.nav');
gnss=importdata('dataset1/GNSS-RTK.txt');
gnss=[zeros(length(gnss),1),gnss];
%% 高度信息仿真
height=gnss(:,[2,5]);
height_output_file="dataset1\height.txt";
try
    writematrix(height, height_output_file, 'Delimiter', ' ');
    fprintf('高度信息已成功写入到 %s\n', height_output_file);
catch ME
    error('错误：写入 height.txt 文件失败。错误信息：%s', ME.message);
end
%% 仿真信标，以gnss为参考计算信标距离
%% 仿真移动信标
glvs
avp0 = [[0;0;d2r(25)]; [0;0;0]; [d2r([30.44;114.48]);10]];
ts=1;
xxx = [];
% seg = trjsegment(xxx, 'init',         0);
% seg = trjsegment(seg, 'uniform',      20); % 保持原来的状态不变
% seg = trjsegment(seg, 'accelerate',   5, xxx, 0.3); % 加速
% seg = trjsegment(seg, 'uniform',      1200);
% % seg = trjsegment(seg, 'headdown', 10, 5);
% seg = trjsegment(seg, 'turnleft', 150, 0.6);
% seg = trjsegment(seg, 'uniform',      400);
% seg = trjsegment(seg, 'turnleft', 20, 3);
% seg = trjsegment(seg, 'uniform',      700);
% seg = trjsegment(seg, 'turnleft', 74, 0.6);
% seg = trjsegment(seg, 'uniform',      430);
% seg = trjsegment(seg, 'turnleft', 18.43, 4);
% seg = trjsegment(seg, 'uniform',      350);

seg = trjsegment(xxx, 'init',         0);
seg = trjsegment(seg, 'accelerate',   5, xxx, 0.3); % 加速
seg = trjsegment(seg, 'uniform',      1200);
seg = trjsegment(seg, 'turnleft', 150, 0.6);
seg = trjsegment(seg, 'uniform',      400);
seg = trjsegment(seg, 'turnleft', 20, 3);
seg = trjsegment(seg, 'uniform',      700);
seg = trjsegment(seg, 'turnleft', 70, 0.6);
seg = trjsegment(seg, 'uniform',      500);
seg = trjsegment(seg, 'turnleft', 18, 4);
seg = trjsegment(seg, 'uniform',      350);

fprintf("航行器轨迹时长（s）：%.2f\n",length(truth)*0.005)
fprintf("仿真轨迹时长（s）：%.2f\n",sum(seg.wat(:,1)))
param = Param();
trj= trjsimu(avp0, seg.wat, ts, 1);
insplot(trj.avp(:,7:9))
bcnMoving=[trj.avp(1:length(gnss),7:8)*param.R2D,trj.avp(1:length(gnss),9)];

%% 信标绘图
figure
bcn=[30.44,114.48,20];
plot3(truth(:,4),truth(:,3),truth(:,5))
hold on
plot3(bcn(2),bcn(1),bcn(3),'*')
hold on
plot3(bcnMoving(:,2),bcnMoving(:,1),bcnMoving(:,3))
grid on
id=1:600/0.005;
id_1s=1:600;
figure
bcn=[30.44,114.48,20];
plot(truth(id,4),truth(id,3))
hold on
plot(bcn(2),bcn(1),'*')
hold on
plot(bcnMoving(id_1s,2),bcnMoving(id_1s,1))
grid on
%% 三个静止信标
close all
pos0=[30.4447873701; 114.4718632047; 20.899];
pos0(1:2)=d2r(pos0(1:2));
BCN(1,:)=dxyz2pos([600,-700,-10],pos0);
BCN(2,:)=dxyz2pos([600,900,-10],pos0);
BCN(3,:)=dxyz2pos([-1800,300,-10],pos0);
BCNddm=BCN;
BCNddm(:,1:2)=r2d(BCN(:,1:2));
figure
plot(truth(:,4),truth(:,3))
hold on
for i=1:3
plot(BCNddm(i,2),BCNddm(i,1),'*')
end
bcn3beacon=repmat(BCNddm, 1137, 1);
bcn3beacon(1137*3)
bcn3beacon(1:3:end,:)=BCNddm(1,:);
bcn3beacon(2:3:end,:)=BCNddm(2,:);
bcn3beacon(3:3:end,:)=BCNddm(3,:);
%% 计算距离
range_static=bcn2range(gnss,bcn);
% i=49;
% disp("计算距离")
% range_static(i,2)
% RCompu([(gnss(i,3:4))/180*pi,gnss(i,5)],[(bcn(1:2))/180*pi,bcn(3)])
%%
% % 将经纬度转换为UTM坐标
% % ll2utm 返回 Easting (m), Northing (m), UTM Zone
% [eastingA, northingA, zoneA] = ll2utm(gnss(i,3), gnss(i,4));
% [eastingB, northingB, zoneB] = ll2utm(bcn(1), bcn(2));
% % 检查两个点是否在同一个UTM区域。
% if ~strcmp(zoneA, zoneB)
%     warning('两个点不在同一个UTM区域，直接在UTM坐标系下计算距离可能不准确。考虑使用geodistance。');
% end
% % 计算UTM坐标下的平面欧氏距离
% deltaE = eastingA - eastingB;
% deltaN = northingA - northingB;
% deltaH = gnss(i,5) - bcn(3);
% distance_utm = sqrt(deltaE^2 + deltaN^2); % 米
% distance_utm1 = sqrt(deltaE^2 + deltaN^2 + deltaH^2); % 米
% fprintf('使用 ll2utm 计算的平面距离：%.2f 米\n', distance_utm);
% fprintf('使用 ll2utm 计算的倾斜距离：%.2f 米\n', distance_utm1);
% 
% % 注意：geodistance的输出单位通常是米，但可以根据椭球体设置而不同
% distance_horizontal = geodistance(gnss(i,[4,3]),bcn([2,1]),4); % 米
% fprintf('使用 geodistance 计算的水平距离：%.2f 米\n', distance_horizontal);
% % 计算三维斜距
% distance_3d = geodistance(gnss(i,[4,3,5]),bcn([2,1,3]),4); % 米
% fprintf('使用 geodistance 计算的三维斜距：%.2f 米\n', distance_3d);
%%
range_moving=bcn2range(gnss,bcnMoving);
% RCompu([(gnss(i,3:4))/180*pi,gnss(i,5)],[(bcnMoving(i,1:2))/180*pi,bcnMoving(i,3)])
% geodistance(gnss(i,3:5),bcnMoving(i,1:3),4)
% range_moving(i,2)
%% 保存数据
range_static(:,2:3)=range_static(:,2:3)+normrnd(0,5,size(range_static(:,2:3)));
range_static_output_file="dataset1\range_static.txt";
try
    writematrix(range_static, range_static_output_file, 'Delimiter', ' ');
    fprintf('高度信息已成功写入到 %s\n', range_static_output_file);
catch ME
    error('错误：写入 range_static.txt 文件失败。错误信息：%s', ME.message);
end


range_moving(:,2:3)=range_moving(:,2:3)+normrnd(0,5,size(range_moving(:,2:3)));
range_moving_output_file="dataset1\range_moving.txt";
try
    writematrix(range_moving, range_moving_output_file, 'Delimiter', ' ');
    fprintf('高度信息已成功写入到 %s\n', range_moving_output_file);
catch ME
    error('错误：写入 range_moving.txt 文件失败。错误信息：%s', ME.message);
end
%%
% function range=bcn2range(truth,bcn)
% param = Param();
% dif(:,1)=truth(:,2);
% dif(:,2:4)=truth(:,3:5)-bcn;
% first_blh = truth(1, 2:4);
% [rm, rn] = getRmRn(first_blh(1) * param.D2R, param);
% h = first_blh(2);
% DR = diag([rm + h, (rn + h)*cos(first_blh(1) * param.D2R), -1]);
% 
% dif(:, 2:3) = dif(:, 2:3) * param.D2R;
% for i = 1:size(dif, 1)
%     delta_pos = DR * (dif(i, 2:4)');
%     dif(i, 2:4) = delta_pos';
% end
% 
% 
% SlantRange=sqrt(sum(dif(:,2:4).^2,2));
% HorizonalRange=sqrt(SlantRange.^2-dif(:,4).^2);
% myfigurestartup(10,4,'prese')
% subplot 121
% plot(dif(:,1),SlantRange);
% title('SlantRange');
% xlabel('Time[s]');
% ylabel('Error[deg]');
% grid("on");
% 
% subplot 122
% plot(dif(:,1),HorizonalRange);
% title('HorizonalRange');
% xlabel('Time[s]');
% ylabel('Error[deg]');
% grid("on");
% if size(bcn,1)==1
%     bcn=ones(size(truth(:,1:3))).*bcn;
% end
% range=[truth(:,2),SlantRange,HorizonalRange,bcn];
% end